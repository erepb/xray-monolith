; Vision 2.0 - occlusion primitive and vision sampler tunables.
; Read once per level load; a console change to a live key (perception_foliage_k,
; perception_canopy_k, perception_atmosphere_k) lasts until then.
; Every key is listed at its default so the shipped values are discoverable here rather than only in
; the C++ initialisers.

[occlusion_model]

; Trim on the measured grass optical depth:
;   transmittance = exp(-foliage_k * tau)
; tau is summed over the detail instances the ray actually passed through - real placement from the
; renderer, real quad area and real atlas alpha - so 1.00 means "take the measurement at its word".
; Raise it if NPCs still see through grass the player cannot, lower it if grass conceals more than it
; looks like it should. It is not a stand-in for the physics; there is no fitted constant behind it.
; Tunable live from the console as perception_foliage_k.
foliage_k                      = 1.00

; Trim on the measured tree-canopy optical depth, the same way foliage_k works for grass:
;   transmittance = exp(-canopy_k * tau)
; tau is summed over the leaf cards the ray actually passes through, each counting how much of its
; texture is leaf right around the point the ray crosses it - so 1.00 again means "take the
; measurement at its word". A ray through the gap between leaves of a big sparse card costs nothing; a
; ray through a dense clump costs nearly everything. Tunable live from the console as
; perception_canopy_k.
canopy_k                       = 1.00

; Metres. How wide a line of sight is, at the observer's eye and at the target. Leaves are judged over
; that width where the ray crosses them: narrow near the eye, so an NPC deep in a bush can still look
; out through gaps around its head, and as wide as a body part near the target, so a pinhole between
; leaves does not reveal someone hiding behind them. Raise canopy_cone_eye if NPCs in bushes see out
; too poorly, lower it if they see out too easily; raise canopy_cone_target if leaves near the target
; hide too little. canopy_cone_eye also sets how fine the leaf textures are read, so lowering it past
; its value at level load takes effect fully only after the next load. Tunable live as
; perception_canopy_cone_eye and perception_canopy_cone_target.
canopy_cone_eye                = 0.05
canopy_cone_target             = 0.30

; Trim on the fog curve measured from the live fog shader:
;   transmittance = measured ^ atmosphere_k
; 1.00 means NPCs lose sight in fog exactly as the player's screen does. Raise it for fog that hides
; more than it looks like it should, lower it for less. 0 switches the fog channel off.
; Tunable live from the console as perception_atmosphere_k.
atmosphere_k                   = 1.00

; Metres. Clamps the terrain part of the height band used for the cheap "is this ray anywhere near
; grass" reject before a slot is resolved. Slot bounds run to 11-22 m where a slot straddles a cliff,
; so this trims the outliers; the grass height on top is never clamped. 0 disables the clamp.
max_slab_h                     = 4.00

; Grass slots worked out per frame, for all NPCs together. A slot not reached in time counts as
; fully blocking for that frame, so too low a value makes NPCs briefly blind through fresh grass -
; perception_cache shows it as budget denials and a degraded share above zero. Each slot costs
; roughly 7-18 us, so 64 is about 0.5-1 ms in the worst frame. Range 1-4096.
resolve_budget                 = 64

; Alpha a grass texel needs to count as drawn, 0..1. Must match the cutoff the grass shader clips at:
; def_aref in shaders\r3\common_defines.h, 200/255 in vanilla and in the GAMMA shader packs. Change it
; only together with a shader pack that changes def_aref.
alpha_ref                      = 0.784

; Grass slots kept once worked out (~700 bytes each at GAMMA density, 32768 is about 22 MB). Too small
; and the same slots are worked out again every few seconds, which spends the budget above; perception_cache
; shows it as evictions per second close to resolves per second. Range 1024-262144.
resolve_cache_slots            = 32768

[vision_feed]

; Least visibility, 0..1, that some part of a target's body needs for an NPC to see it at all, after
; grass, leaves and fog. Raise it if NPCs spot targets that are all but hidden; lower it if a target
; deep in grass or fog is never seen. Sight lines that fog alone thins below it are not checked for
; grass and leaves.
visible_min                    = 0.05

[vision_sampler]

; Rays per tracked target, per NPC, per vision update (10 tracked creatures at 2 = 20 rays). One ray
; always goes to a point the NPC keeps while it stays visible, so whether the target is seen behaves
; as in vanilla. Every ray past the first goes to the next body part in turn, and those decide how much
; of the target shows: 1 detects a partly hidden target as fast as its best visible part, 2 or more
; slow detection by how much is hidden. More keeps a moving target's reading fresher at the cost of
; rays. Range 1-64. Only used while perception_shadow or perception_explain is on; NPC detection does
; not use it yet.
points                         = 2

; Metres either end of a sight line may move before the reading taken along it is redone in full.
; While neither end moves, only creatures, doors and other moving things can change what is in the
; way, so only they are checked again. Lower it if NPCs keep seeing through grass or leaves that a
; target has just stepped behind; raise it to save work. Range 0-1.
current_eps                    = 0.10

; How often a still sight line is redone in full, on a fresh point of the same body part: every this
; many checks of that part. In between only moving things are checked again. Lower it if partly
; covered body parts read too all-or-nothing; raise it to save work. 1 redoes every check. Range 1-64.
refresh_visits                 = 4
